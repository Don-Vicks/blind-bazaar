{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "auction",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ADMIN_TOKEN=dev-admin-token",
        "DATA_DIR=./data",
        "BIND=127.0.0.1:8787",
        "SYNC_INTERVAL_SECS=10",
        "OPERATOR_EMAIL=ops@example.test",
        "target/debug/bb-auction"
      ],
      "port": 8787
    },
    {
      "name": "auction-paused",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ADMIN_TOKEN=dev-admin-token",
        "DATA_DIR=./data",
        "BIND=127.0.0.1:8787",
        "SYNC_INTERVAL_SECS=10",
        "PAUSED=true",
        "target/debug/bb-auction"
      ],
      "port": 8787
    },
    {
      "name": "auction-freeze-planned",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ADMIN_TOKEN=dev-admin-token",
        "DATA_DIR=./data",
        "BIND=127.0.0.1:8787",
        "SYNC_INTERVAL_SECS=10",
        "FREEZE_HEIGHT=4600000",
        "target/debug/bb-auction"
      ],
      "port": 8787
    },
    {
      "name": "viewer",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ADMIN_TOKEN=dev-admin-token",
        "LEDGER_TOKEN=dev-ledger-token",
        "SYNC_INTERVAL_SECS=10",
        "BIRTHDAY_HEIGHT=4515600",
        "ROLE=viewer",
        "OPERATOR_",
        "DATA_DIR=./data/viewer",
        "BIND=127.0.0.1:8787",
        "target/debug/bb-auction"
      ],
      "port": 8787
    },
    {
      "name": "spender",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ADMIN_TOKEN=dev-admin-token",
        "LEDGER_TOKEN=dev-ledger-token",
        "SYNC_INTERVAL_SECS=10",
        "BIRTHDAY_HEIGHT=4515600",
        "ROLE=spender",
        "VIEWER_URL=http://127.0.0.1:8787",
        "OPERATOR_SEED_FILE=./data/operator.seed",
        "DATA_DIR=./data/spender",
        "BIND=127.0.0.1:8788",
        "target/debug/bb-auction"
      ],
      "port": 8788
    },
    {
      "name": "regtest",
      "runtimeExecutable": "zeckit",
      "runtimeArgs": [
        "up",
        "--backend",
        "lwd"
      ],
      "port": 8080
    }
  ]
}
