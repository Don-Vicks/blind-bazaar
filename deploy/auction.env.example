NETWORK=main
LIGHTWALLETD_URL=https://zec.rocks:443
ADMIN_TOKEN=replace-with-a-long-random-string
CORS_ORIGIN=https://your.site
WEBHOOK_URL=
SETTLEMENT_WINDOW_SECS=86400
REFUND_DELAY_MIN_SECS=30
REFUND_DELAY_MAX_SECS=300
FEE_RESERVE_ZATS=1000000
RUST_LOG=info

# --- FROST escrow (optional; spender/all role) ---
# Generate with `bb-auction frost keygen --out ./frost`; keep signer-N.json on separate hosts.
# FROST_ESCROW=./frost/escrow.json
# FROST_SIGNERS=https://signer-1.example:8801,https://signer-2.example:8801,https://signer-3.example:8801
# FROST_TOKEN=change-me
# Signer host: `bb-auction frost signer --share signer-1.json --escrow escrow.json --bind 0.0.0.0:8801 --max-external-zats 100000000`
