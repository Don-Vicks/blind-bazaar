NETWORK=main
LIGHTWALLETD_URL=https://zec.rocks:443
ADMIN_TOKEN=replace-with-a-long-random-string
CORS_ORIGIN=https://your.site
# Behind Caddy or another reverse proxy: rate-limit by the forwarded client address.
TRUST_PROXY=true
WEBHOOK_URL=
SETTLEMENT_WINDOW_SECS=86400
REFUND_DELAY_MIN_SECS=30
REFUND_DELAY_MAX_SECS=300
FEE_RESERVE_ZATS=1000000
RUST_LOG=info

# Refund timing: random delay in this range, rounded up to the window; refunds due in one window leave in one
# transaction (up to REFUND_BATCH_MAX outputs). Production: minutes to hours. The demo uses 5-15 s and says so.
REFUND_DELAY_MIN_SECS=600
REFUND_DELAY_MAX_SECS=14400
REFUND_WINDOW_SECS=600
REFUND_BATCH_MAX=8

# --- FROST escrow (optional; spender/all role) ---
# Generate with `bb-auction frost keygen --out ./frost`; keep signer-N.json on separate hosts.
# FROST_ESCROW=./frost/escrow.json
# One credential per signer (url|token); each signer host runs with its own FROST_TOKEN.
# FROST_SIGNERS=https://signer-1.example:8801|token-1,https://signer-2.example:8801|token-2,https://signer-3.example:8801|token-3
# Signer host: `bb-auction frost signer --share signer-1.json --escrow escrow.json --bind 0.0.0.0:8801 --max-external-zats 100000000`
