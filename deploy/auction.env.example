NETWORK=main
LIGHTWALLETD_URL=https://zec.rocks:443
ADMIN_TOKEN=replace-with-a-long-random-string
CORS_ORIGIN=https://your.site
# Behind Caddy or another reverse proxy: rate-limit by the forwarded client address.
TRUST_PROXY=true
WEBHOOK_URL=
SETTLEMENT_WINDOW_SECS=86400
REFUND_DELAY_MIN_SECS=30
REFUND_DELAY_MAX_SECS=300
FEE_RESERVE_ZATS=1000000
RUST_LOG=info

# Opt-in notifications (bidders and sellers who leave an email). Unset = recorded and logged, not sent.
# NOTIFY_SMTP_URL=smtps://user:pass@smtp.example:465
# NOTIFY_FROM=Blind Bazaar <no-reply@your.site>
SITE_URL=https://your.site
# Operator alerts (low float, a payout that exhausted its retries, the service parking itself). Same mailer.
# OPERATOR_EMAIL=ops@your.site

# Blocks on top of a deposit before it counts (one-block reorgs are common on Zcash).
INGEST_CONFIRMATIONS=2

# This build does not follow mainnet past NU7 (expected around Nov 5, 2026; height announced by ECC/ZF). Set the
# activation height here: from that block the service parks itself (no sync, no closes, no spends; write endpoints
# answer 503; results and proofs stay readable) and lots that could not settle before it are refused.
# PAUSED=true parks it immediately.
#FREEZE_HEIGHT=

# Lot deposits come from a standard menu (0.001 to 5 ZEC, 1-2-5 series) so a refund amount does not mark its lot.
#ALLOW_ANY_DEPOSIT=false

# Refund timing: random delay in this range, rounded up to the window; refunds due in one window leave in one
# transaction (up to REFUND_BATCH_MAX outputs). Production: minutes to hours. The demo uses 5-15 s and says so.
REFUND_DELAY_MIN_SECS=600
REFUND_DELAY_MAX_SECS=14400
REFUND_WINDOW_SECS=600
REFUND_BATCH_MAX=8

# --- FROST escrow (optional; spender/all role) ---
# Generate with `bb-auction frost keygen --out ./frost`; keep signer-N.json on separate hosts.
# FROST_ESCROW=./frost/escrow.json
# One credential per signer (url|token); each signer host runs with its own FROST_TOKEN.
# FROST_SIGNERS=https://signer-1.example:8801|token-1,https://signer-2.example:8801|token-2,https://signer-3.example:8801|token-3
# Signer host: `bb-auction frost signer --share signer-1.json --escrow escrow.json --bind 0.0.0.0:8801 --max-external-zats 100000000 --max-external-per-window-zats 500000000 --ledger-url https://viewer.example --ledger-token …`
# LEDGER_TOKEN: read-only token the viewer accepts on /ledger/payouts (give it to the signers and the spender).
# LEDGER_TOKEN=change-me-too
