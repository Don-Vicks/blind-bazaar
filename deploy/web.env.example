NEXT_PUBLIC_BB_API=https://your.site/bb
NEXT_PUBLIC_SITE_URL=https://your.site
# Origins allowed to use the pay button proxy from other sites. Same-origin calls are always allowed.
GODARK_ALLOWED_ORIGINS=
ONECLICK_JWT=
# Behind the Caddy proxy from deploy/: rate-limit the proxy routes by the forwarded client address.
GODARK_TRUST_PROXY=true
