FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /src
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile && pnpm -r --filter @blind-bazaar/sdk --filter @blind-bazaar/go-dark build \
    && cp packages/go-dark/dist/go-dark.iife.js apps/web/public/go-dark.iife.js \
    && pnpm --filter web build

FROM node:22-bookworm-slim
RUN corepack enable && useradd -r -u 10001 web
WORKDIR /app
COPY --from=build /src /app
USER web
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
CMD ["pnpm", "--filter", "web", "start"]
