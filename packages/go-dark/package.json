{
  "name": "@blind-bazaar/go-dark",
  "version": "0.1.0",
  "description": "Embeddable button that turns SOL, USDC or ETH into shielded ZEC at a Zcash address.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.0",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
